doctype html
html(lang="en", class="mechanic-map-dark mechanic-map-green")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    meta(name="color-scheme", content="dark")
    title Assist IQ | Mechanic Route
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
    link(
      href="https://fonts.googleapis.com/css2?family=Matangi:wght@500;700&family=Nunito:wght@400;600;700&family=Quicksand:wght@500;700&display=swap",
      rel="stylesheet"
    )
    link(rel="stylesheet", href="/css/mechanic-dark.css")
    link(
      rel="stylesheet",
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css",
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=",
      crossorigin=""
    )
  body(class="mechanic-dark mechanic-map-dark mechanic-map-green")
    div#map(role="application", aria-label="Mechanic service route map")
    div(class="map-green-glow", aria-hidden="true")

    header(class="map-header")
      div(class="map-header-inner")
        div(class="map-bar")
          div(class="map-brand")
            span(class="map-brand-dot")
            div
              div(class="map-title") Route to Mechanic
              div(class="map-subtitle") Your location → nearest shop
          a(class="back-btn", href="/mechanic-service") Back
        div(class="shop-details")
          h2#shopName Finding nearest mechanic…
          p#shopAddress
          p#shopContact
        div(class="route-info")
          span#routeDistance(class="route-chip") Distance: —
          span#routeDuration(class="route-chip") Duration: —

    div#mapStatus(class="map-status") Locating you and loading route…

    script#mechanicShopsData(type="application/json")!= JSON.stringify(shops)

    script(
      src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js",
      integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=",
      crossorigin=""
    )
    script(src="/js/mechanic-map.js")
