doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= "My Cart - AssistIQ"
    link(rel="stylesheet" href="/css/user-cart.css")
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet")
  body
    header.header 
      .header-content
        .logo
          a(href="/user") AssistIQ
        .header-actions
          a.btn.btn-outline(href="/food-delivery")
            span ← Back to Menu
          span.user-email= email

    main.main-content
      .cart-container
        h1.page-title 🛒 My Cart

        .cart-layout
          // Cart Items Section
          .cart-items-section
            .cart-header
              h2 Order Items
              span.item-count= cartItems.length + ' item' + (cartItems.length !== 1 ? 's' : '')

            if cartItems.length === 0
              .empty-cart
                .empty-icon 🛒
                h3 Your cart is empty
                p No items added yet. Browse our menu to add delicious dishes!
                a.btn.btn-primary(href="/food-delivery") Browse Menu →
            else
              .cart-list
                each item, index in cartItems
                  form.cart-item(action="/delete-item" method="post")
                    input(type="hidden" name="cartIndex" value=`${JSON.stringify(item)}`)
                    .cart-item-image
                      img(src=item.image_url || '/foodie.png' alt=item.foodname onerror="this.src='/foodie.png'")
                    .cart-item-info
                      .cart-item-name= item.foodname
                      .cart-item-hotel= item.hotelname
                      .cart-item-price= '₹' + (item.price * item.quantity).toLocaleString('en-IN')
                    .cart-item-quantity
                      .qty-controls
                        button.qty-btn.qty-minus(data-action="decrease" data-index=index) −
                        span.qty-value= item.quantity
                        button.qty-btn.qty-plus(data-action="increase" data-index=index) +
                    .cart-item-total
                      span.total-label Total
                      span.total-value= '₹' + (item.price * item.quantity).toLocaleString('en-IN')
                      button.remove(type="submit" title="Cancel item") X

          // Order Summary Section
          .cart-summary
            .summary-card
              h2 Order Summary
              
              .summary-row
                span.label Subtotal (#{cartItems.reduce((sum, item) => sum + (item.price * item.quantity), 0).toLocaleString('en-IN')})
                span.value= '₹' + cartItems.reduce((sum, item) => sum + (item.price * item.quantity), 0).toLocaleString('en-IN')
              
              .summary-row
                span.label Delivery Fee
                span.value= '₹' + (cartItems.length > 0 ? 30 : 0)
              
              .summary-row
                span.label Taxes & Charges
                span.value= '₹' + Math.round(cartItems.reduce((sum, item) => sum + (item.price * item.quantity), 0) * 0.05).toLocaleString('en-IN')
              
              .summary-divider
              
              .summary-row.summary-total
                span.label Grand Total
                span.value= '₹' + (cartItems.reduce((sum, item) => sum + (item.price * item.quantity), 0) + (cartItems.length > 0 ? 30 : 0) + Math.round(cartItems.reduce((sum, item) => sum + (item.price * item.quantity), 0) * 0.05)).toLocaleString('en-IN')

              if cartItems.length > 0
                .checkout-section
                  button.btn.btn-primary.btn-checkout#checkoutBtn
                    span Track on Map
                    span.arrow →
                  
                  // Payment Button (hidden initially)
                  .payment-section#paymentSection(style="display: none;")
                    button.btn.btn-primary.btn-pay#payBtn
                      span Pay ₹
                      span#payAmount 0
                  
                  .payment-info
                    .payment-method
                      span.icon 💳
                      span.text Cash on Delivery

        // Placeholder for backend data fetching
        script#cartData(type="application/json" data-email=email)!= JSON.stringify({email: email, items: cartItems, selected: cartItems})

        // Map Modal for tracking restaurants
        script(src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="")
        link(rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="")

    // Map Modal for tracking restaurants
    .map-modal-overlay#mapModal(hidden)
      .map-modal
        .map-modal-header
          h2.map-modal-title 🗺️ Track Restaurants
          button.map-modal-close#btnCloseMap(aria-label="Close map") ×
        .map-modal-body
          #deliveryMap.delivery-map
          .map-modal-info
            .map-location-info
              span.location-label 📍 From:
              span#userLocationText.location-text Detecting your location...
            .map-location-info
              span.location-label 🏪 To:
              span#hotelLocationText.location-text -
            .map-distance-info
              span#distanceText.distance-text Calculating distances...

    footer.footer
      .footer-content
        span © 2024 AssistIQ. All rights reserved.
        .footer-links
          a(href="/user") Dashboard
          a(href="/food-delivery") Food Delivery
          a(href="#") Help & Support

    script.
      document.addEventListener('DOMContentLoaded', function() {
        // Quantity controls
        document.querySelectorAll('.qty-btn').forEach(function(btn) {
          btn.addEventListener('click', function() {
            const action = this.getAttribute('data-action');
            const index = this.getAttribute('data-index');
            const qtyValue = this.closest('.cart-item').querySelector('.qty-value');
            let qty = parseInt(qtyValue.textContent);
            
            if (action === 'increase') {
              qty = Math.min(qty + 1, 99);
            } else if (action === 'decrease') {
              qty = Math.max(qty - 1, 1);
            }
            
            qtyValue.textContent = qty;
            updateItemTotal(index);
            updateSummary();
          });
        });

        // Remove item
        document.querySelectorAll('.remove-btn').forEach(function(btn) {
          btn.addEventListener('click', function() {
            const index = this.getAttribute('data-index');
            const item = this.closest('.cart-item');
            
            if (confirm('Remove this item from cart?')) {
              item.style.animation = 'fadeOut 0.3s ease forwards';
              setTimeout(function() {
                item.remove();
                updateItemCount();
                updateSummary();
              }, 300);
            }
          });
        });

        // Map state
        var deliveryMap = null;
        var userMarker = null;
        var hotelMarkers = [];
        var routesLayers = [];
        var userLocation = null;
        var allRestaurants = [];

        // Get restaurant data from cart items
        try {
          var cartDataEl = document.getElementById('cartData');
          if (cartDataEl) {
            var cartData = JSON.parse(cartDataEl.textContent || '{}');
            var selectedRestaurants = cartData.selected || cartData.items || [];
            allRestaurants = selectedRestaurants;
          }
        } catch(e) {
          allRestaurants = [];
        }

        // Checkout button - open map modal
        document.getElementById('checkoutBtn').addEventListener('click', function() {
          openMapModal();
        });

        // Close map modal
        var btnCloseMap = document.getElementById('btnCloseMap');
        if (btnCloseMap) {
          btnCloseMap.addEventListener('click', closeMapModal);
        }

        // Close map when clicking overlay
        var mapModal = document.getElementById('mapModal');
        if (mapModal) {
          mapModal.addEventListener('click', function(event) {
            if (event.target === mapModal) {
              closeMapModal();
            }
          });
        }

        // Close map on Escape key
        document.addEventListener('keydown', function(event) {
          if (event.key === 'Escape') {
            closeMapModal();
          }
        });

        function openMapModal() {
          mapModal.hidden = false;
          
          // Reset UI
          document.getElementById('userLocationText').textContent = 'Detecting your location...';
          document.getElementById('hotelLocationText').textContent = '-';
          document.getElementById('distanceText').textContent = 'Calculating distances...';

          // Get user's current location
          if ('geolocation' in navigator) {
            navigator.geolocation.getCurrentPosition(
              function(position) {
                userLocation = {
                  lat: position.coords.latitude,
                  lng: position.coords.longitude
                };
                document.getElementById('userLocationText').textContent = 
                  userLocation.lat.toFixed(4) + ', ' + userLocation.lng.toFixed(4);
                renderMap();
              },
              function(error) {
                console.error('Geolocation error:', error);
                // Default to Tirupati if geolocation fails
                userLocation = { lat: 13.6288, lng: 79.4192 };
                document.getElementById('userLocationText').textContent = 'Using default location (Tirupati)';
                renderMap();
              },
              {
                enableHighAccuracy: true,
                timeout: 10000,
                maximumAge: 0
              }
            );
          } else {
            userLocation = { lat: 13.6288, lng: 79.4192 };
            document.getElementById('userLocationText').textContent = 'Geolocation not supported, using default';
            renderMap();
          }
        }

        function closeMapModal() {
          if (mapModal) {
            mapModal.hidden = true;
          }
          if (deliveryMap) {
            deliveryMap.remove();
            deliveryMap = null;
          }
          userMarker = null;
          hotelMarkers = [];
          routesLayers = [];
        }

        function renderMap() {
          if (!userLocation) return;

          // Destroy existing map
          if (deliveryMap) {
            deliveryMap.remove();
            deliveryMap = null;
          }

          var mapContainer = document.getElementById('deliveryMap');
          if (!mapContainer) return;

          // Create map
          deliveryMap = L.map('deliveryMap').setView([userLocation.lat, userLocation.lng], 13);

          // Add dark theme tile layer
          L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
            subdomains: 'abcd',
            maxZoom: 19
          }).addTo(deliveryMap);

          // Add user location marker with blinking effect
          var userIcon = L.divIcon({
            className: 'custom-div-icon',
            html: "<div class='user-marker-blink' style='background-color:#4ade80;width:16px;height:16px;border-radius:50%;border:3px solid white;box-shadow:0 2px 8px rgba(74,222,128,0.6);'></div>",
            iconSize: [22, 22],
            iconAnchor: [11, 11]
          });

          userMarker = L.marker([userLocation.lat, userLocation.lng], { icon: userIcon })
            .addTo(deliveryMap)
            .bindPopup('Your Location');

          // Get address for user location using reverse geocoding
          getAddressFromCoords(userLocation.lat, userLocation.lng).then(function(address) {
            document.getElementById('userLocationText').textContent = address || (userLocation.lat.toFixed(4) + ', ' + userLocation.lng.toFixed(4));
          }).catch(function() {
            document.getElementById('userLocationText').textContent = userLocation.lat.toFixed(4) + ', ' + userLocation.lng.toFixed(4);
          });

          // Group cart items by hotel and collect unique restaurant locations
          var hotelGroups = {};
          allRestaurants.forEach(function(item) {
            if (!item.hotelname) return;
            var hotel = item.hotelname;
            if (!hotelGroups[hotel]) {
              hotelGroups[hotel] = {
                name: hotel,
                lat: item.latitude !== undefined && item.latitude !== null ? Number(item.latitude) : null,
                lng: item.longitude !== undefined && item.longitude !== null ? Number(item.longitude) : null,
                foods: []
              };
            }
            if (item.foodname && hotelGroups[hotel].foods.indexOf(item.foodname) === -1) {
              hotelGroups[hotel].foods.push(item.foodname);
            }
          });

          var hotelLocations = Object.values(hotelGroups).filter(function(group) {
            return group.lat !== null && group.lng !== null;
          });

          if (hotelLocations.length === 0) {
            hotelLocations.push({
              name: 'Selected Restaurant',
              lat: 13.6288,
              lng: 79.4192,
              foods: []
            });
          }

          document.getElementById('hotelLocationText').textContent = 
            hotelLocations.map(function(h) { 
              return h.name + (h.foods.length ? ' (' + h.foods.join(', ') + ')' : '');
            }).join(' | ');

          // Add hotel markers with hotel icon and blinking effect
          var hotelIcon = L.divIcon({
            className: 'custom-div-icon',
            html: "<div class='hotel-marker-blink' style='background-color:#f87171;width:28px;height:28px;border-radius:50%;border:3px solid white;box-shadow:0 2px 8px rgba(248,113,113,0.6);display:flex;align-items:center;justify-content:center;font-size:14px;'>🏨</div>",
            iconSize: [34, 34],
            iconAnchor: [17, 17]
          });

          hotelLocations.forEach(function(hotel) {
            var popupContent = '<b>🏨 ' + hotel.name + '</b>';
            if (hotel.foods && hotel.foods.length) {
              popupContent += '<br><small>Foods: ' + hotel.foods.join(', ') + '</small>';
            }

            var marker = L.marker([hotel.lat, hotel.lng], { icon: hotelIcon })
              .addTo(deliveryMap)
              .bindPopup(popupContent);
            hotelMarkers.push(marker);
          });

          // Calculate and display routes using OSRM - one route per restaurant
          fetchRoutes(userLocation, hotelLocations).then(function(routes) {
            var totalDistance = 0;
            var routeColors = ['#4ade80', '#60a5fa', '#f472b6', '#fbbf24', '#a78bfa', '#fb923c', '#34d399', '#f87171'];
            
            routes.forEach(function(route, index) {
              if (route.latlngs && route.latlngs.length > 0) {
                var color = routeColors[index % routeColors.length];
                var polyline = L.polyline(route.latlngs, {
                  color: color,
                  weight: 4,
                  opacity: 0.8,
                  dashArray: '10, 10'
                }).addTo(deliveryMap);
                routesLayers.push(polyline);

                // Calculate distance
                var distance = calculateDistance(userLocation, route.destination);
                totalDistance += distance;
              }
            });

            document.getElementById('distanceText').textContent = 
              'Showing routes to ' + hotelLocations.length + ' restaurants | Total distance: ' + totalDistance.toFixed(1) + ' km';

            // Fit map to show all markers
            var allPoints = [[userLocation.lat, userLocation.lng]];
            hotelLocations.forEach(function(h) {
              allPoints.push([h.lat, h.lng]);
            });
            deliveryMap.fitBounds(allPoints, { padding: [50, 50] });
          });
        }

        function fetchRoutes(start, destinations) {
          var routes = [];
          var promises = destinations.map(function(dest) {
            return fetch('https://router.project-osrm.org/route/v1/driving/' + start.lng + ',' + start.lat + ';' + dest.lng + ',' + dest.lat + '?overview=full&geometries=geojson')
              .then(function(response) {
                return response.json();
              })
              .then(function(data) {
                if (data.routes && data.routes.length > 0) {
                  var route = data.routes[0];
                  var coordinates = route.geometry.coordinates;
                  var latlngs = coordinates.map(function(coord) {
                    return [coord[1], coord[0]];
                  });
                  routes.push({
                    latlngs: latlngs,
                    destination: {
                      lat: dest.lat,
                      lng: dest.lng,
                      name: dest.name,
                      foods: dest.foods || []
                    }
                  });
                }
              })
              .catch(function(error) {
                console.error('Route fetch error:', error);
                // Fallback to straight line
                routes.push({
                  latlngs: [[start.lat, start.lng], [dest.lat, dest.lng]],
                  destination: {
                    lat: dest.lat,
                    lng: dest.lng,
                    name: dest.name,
                    foods: dest.foods || []
                  }
                });
              });
          });

          return Promise.all(promises).then(function() {
            return routes;
          });
        }

        function calculateDistance(start, end) {
          var R = 6371; // Earth's radius in km
          var dLat = toRad(end.lat - start.lat);
          var dLng = toRad(end.lng - start.lng);
          var a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                    Math.cos(toRad(start.lat)) * Math.cos(toRad(end.lat)) *
                    Math.sin(dLng / 2) * Math.sin(dLng / 2);
          var c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
          return R * c;
        }

        function toRad(deg) {
          return deg * (Math.PI / 180);
        }

        function getAddressFromCoords(lat, lng) {
          return fetch('https://nominatim.openstreetmap.org/reverse?format=json&lat=' + lat + '&lon=' + lng + '&zoom=18&addressdetails=1')
            .then(function(response) {
              return response.json();
            })
            .then(function(data) {
              if (data && data.display_name) {
                var address = data.display_name;
                if (address.length > 80) {
                  address = address.substring(0, 80) + '...';
                }
                return address;
              }
              return null;
            })
            .catch(function(error) {
              console.error('Reverse geocoding error:', error);
              return null;
            });
        }

        // Pay button
        document.getElementById('payBtn').addEventListener('click', function() {
          var amount = document.getElementById('payAmount').textContent;
          alert('Payment of ₹' + amount + ' initiated successfully! Your order is being processed.');
        });

        function updateItemTotal(index) {
        var item = document.querySelector('.cart-item[data-index="' + index + '"]');
        if (!item) return;
        
        var priceText = item.querySelector('.cart-item-price').textContent;
        var qty = parseInt(item.querySelector('.qty-value').textContent);
        var price = parseInt(priceText.replace(/₹|,/g, ''));
        

        var newTotal = price * qty;
        item.querySelector('.total-value').textContent = '₹' + newTotal.toLocaleString('en-IN');
        }
      });

      function updateSummary() {
        var subtotal = 0;
        document.querySelectorAll('.cart-item').forEach(function(item) {
          var totalText = item.querySelector('.total-value').textContent;
          subtotal += parseInt(totalText.replace(/₹|,/g, ''));
        });
        
        var delivery = subtotal > 0 ? 30 : 0;
        var taxes = Math.round(subtotal * 0.05);
        var grandTotal = subtotal + delivery + taxes;
        
        var summaryRows = document.querySelectorAll('.summary-row');
        if (summaryRows[0]) {
          summaryRows[0].querySelector('.value').textContent = '₹' + subtotal.toLocaleString('en-IN');
        }
        if (summaryRows[1]) {
          summaryRows[1].querySelector('.value').textContent = '₹' + delivery;
        }
        if (summaryRows[2]) {
          summaryRows[2].querySelector('.value').textContent = '₹' + taxes;
        }
        if (summaryRows[4]) {
          summaryRows[4].querySelector('.value').textContent = '₹' + grandTotal.toLocaleString('en-IN');
        }

        // Update pay button amount if visible
        var paySection = document.getElementById('paymentSection');
        if (paySection && paySection.style.display !== 'none') {
          document.getElementById('payAmount').textContent = grandTotal.toLocaleString('en-IN');
        }
      }

      function calculateGrandTotal() {
        var subtotal = 0;
        document.querySelectorAll('.cart-item').forEach(function(item) {
          var totalText = item.querySelector('.total-value').textContent;
          subtotal += parseInt(totalText.replace(/₹|,/g, ''));
        });
        var delivery = subtotal > 0 ? 30 : 0;
        var taxes = Math.round(subtotal * 0.05);
        return subtotal + delivery + taxes;
      }

      function updateItemCount() {
        var items = document.querySelectorAll('.cart-item');
        var countEl = document.querySelector('.item-count');
        if (countEl) {
          countEl.textContent = items.length + ' item' + (items.length !== 1 ? 's' : '');
        }
        
        if (items.length === 0) {
          location.reload(); // Show empty cart state
        }
      }

    style.
      @keyframes fadeOut {
        from { opacity: 1; transform: translateX(0); }
        to { opacity: 0; transform: translateX(-20px); }
      }

      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
      }

      @keyframes blink-button {
        0%, 100% {
          opacity: 1;
          box-shadow: 0 4px 15px rgba(34, 197, 94, 0.4);
        }
        50% {
          opacity: 0.7;
          box-shadow: 0 4px 25px rgba(34, 197, 94, 0.7), 0 0 35px rgba(34, 197, 94, 0.3);
        }
      }

      @keyframes blink-marker {
        0%, 100% {
          opacity: 1;
          transform: scale(1);
          box-shadow: 0 2px 8px rgba(74, 222, 128, 0.6);
        }
        50% {
          opacity: 0.5;
          transform: scale(1.15);
          box-shadow: 0 2px 16px rgba(74, 222, 128, 0.9);
        }
      }

      .payment-section {
        margin-top: 1rem;
        animation: fadeIn 0.3s ease;
      }

      .btn-pay {
        width: 100%;
        padding: 1rem;
        font-size: 1.125rem;
        font-weight: 700;
        justify-content: center;
        background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
        box-shadow: 0 4px 15px rgba(34, 197, 94, 0.4);
      }

      .btn-pay:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(34, 197, 94, 0.5);
      }

      .btn-checkout {
        animation: blink-button 1.5s ease-in-out infinite;
      }

      /* Map Modal Styles */
      .map-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.75);
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        animation: fadeIn 0.3s ease;
      }

      .map-modal-overlay[hidden] {
        display: none;
      }

      .map-modal {
        width: min(800px, 95vw);
        max-height: 90vh;
        border-radius: 16px;
        border: 1px solid rgba(34, 197, 94, 0.5);
        background: linear-gradient(160deg, rgba(8, 20, 14, 0.98), rgba(4, 10, 8, 0.98));
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        color: #ecfdf5;
      }

      .map-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid rgba(34, 197, 94, 0.25);
      }

      .map-modal-title {
        font-family: 'Inter', sans-serif;
        font-size: 1.2rem;
        font-weight: 600;
        color: #4ade80;
        margin: 0;
      }

      .map-modal-close {
        width: 2rem;
        height: 2rem;
        border-radius: 50%;
        border: 1px solid rgba(34, 197, 94, 0.45);
        background: rgba(0, 0, 0, 0.5);
        color: #bbf7d0;
        font-size: 1.1rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
      }

      .map-modal-close:hover {
        background: rgba(34, 197, 94, 0.2);
        color: #ecfdf5;
      }

      .map-modal-body {
        flex: 1;
        overflow-y: auto;
        padding: 1rem;
      }

      .delivery-map {
        width: 100%;
        height: 400px;
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 1rem;
        background: rgba(0, 0, 0, 0.3);
      }

      .delivery-map .leaflet-container {
        background: #1a1a2e;
      }

      .map-modal-info {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      .map-location-info {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        background: rgba(0, 0, 0, 0.25);
      }

      .location-label {
        font-size: 0.9rem;
        flex-shrink: 0;
      }

      .location-text {
        font-family: 'Inter', sans-serif;
        font-size: 0.85rem;
        color: #ecfdf5;
        word-break: break-word;
      }

      .map-distance-info {
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        background: rgba(34, 197, 94, 0.1);
        border: 1px solid rgba(34, 197, 94, 0.25);
      }

