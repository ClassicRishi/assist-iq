doctype html
html(lang="en", class="mechanic-map-dark mechanic-map-green")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    meta(name="color-scheme", content="dark")
    title Assist IQ | Police Stations
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
    link(
      href="https://fonts.googleapis.com/css2?family=Matangi:wght@500;700&family=Nunito:wght@400;600;700&family=Quicksand:wght@500;700&display=swap",
      rel="stylesheet"
    )
    link(rel="stylesheet", href="/css/mechanic-dark.css")
    link(rel="stylesheet", href="/css/police-stations.css")
    link(
      rel="stylesheet",
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css",
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=",
      crossorigin=""
    )
  body(class="mechanic-dark mechanic-map-dark mechanic-map-green police-page")
    div(class="police-layout")
      aside(class="police-panel")
        div(class="police-panel-header")
          div(class="police-panel-brand")
            span(class="police-panel-brand-dot")
            div
              h1(class="police-panel-title") Nearest Police Stations
              p(class="police-panel-subtitle") Top 4 nearest stations from your location
          a(class="back-btn", href="/police-back") Back
        div#policeStatus(class="police-status") Getting your location…
        p(class="police-list-hint") Tap a station to view on map
        div#policeStationList(class="police-station-list")

      div(class="police-map-wrap")
        div(class="police-map-glow", aria-hidden="true")
        div#policeMap(role="application", aria-label="Nearest police stations map")

    script#policeStationsData(type="application/json")!= JSON.stringify(stations)

    script(
      src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js",
      integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=",
      crossorigin=""
    )
    script(src="/js/police-stations-map.js")
