doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Assist IQ | Profile Updated
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
    link(
      href="https://fonts.googleapis.com/css2?family=Matangi:wght@400;600;700&family=Nunito:wght@400;500;600;700&family=Quicksand:wght@400;500;600;700&display=swap",
      rel="stylesheet"
    )
    style.
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        font-family: "Nunito", Arial, sans-serif;
        background: radial-gradient(circle at top, #1a1a1a 0%, #0f0f0f 42%, #000000 100%);
        color: #d1fae5;
      }
      .success-shell {
        width: min(560px, 92%);
        padding: 2rem;
        border-radius: 20px;
        border: 1px solid rgba(34, 197, 94, 0.45);
        background: linear-gradient(145deg, rgba(6, 78, 59, 0.28), rgba(4, 20, 14, 0.95));
        text-align: center;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
      }
      .success-icon {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        margin: 0 auto 1rem;
        display: grid;
        place-items: center;
        background: radial-gradient(circle, rgba(34, 197, 94, 0.35), rgba(34, 197, 94, 0.08));
        border: 2px solid rgba(34, 197, 94, 0.65);
      }
      .success-icon svg {
        width: 38px;
        height: 38px;
        color: #22c55e;
      }
      .success-title {
        margin: 0 0 0.6rem;
        font-family: "Matangi", sans-serif;
        font-size: 2rem;
        color: #4ade80;
      }
      .success-text {
        margin: 0 0 1.4rem;
        color: #bbf7d0;
        font-size: 1rem;
      }
      .back-btn {
        display: inline-block;
        text-decoration: none;
        border-radius: 999px;
        padding: 0.65rem 1.25rem;
        font-family: "Quicksand", sans-serif;
        font-weight: 700;
        font-size: 0.95rem;
        border: 1px solid #22c55e;
        background: #22c55e;
        color: #052e16;
        transition: all 0.2s ease;
      }
      .back-btn:hover {
        background: #4ade80;
        transform: translateY(-1px);
      }
  body
    div(class="success-shell")
      div(class="success-icon")
        svg(viewBox="0 0 24 24", fill="none", xmlns="http://www.w3.org/2000/svg", aria-hidden="true")
          path(d="M20 7 9.5 17.5 4 12", stroke="currentColor", stroke-width="2.4", stroke-linecap="round", stroke-linejoin="round")
      div(class="success-title") Profile Updated Successfully
      div(class="success-text") Your profile details were saved successfully.
      div(class="success-action")
        a(class="back-btn", href="/user") Back to Profile
