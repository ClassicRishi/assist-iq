doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    meta(name="color-scheme", content="dark")
    title Assist IQ | Mechanic Service
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
    link(
      href="https://fonts.googleapis.com/css2?family=Matangi:wght@500;700&family=Nunito:wght@400;600;700&family=Quicksand:wght@500;700&display=swap",
      rel="stylesheet"
    )
    link(rel="stylesheet", href="/css/mechanic-dark.css")
  body(class="mechanic-dark")
    nav(class="nav")
      div(class="nav-wrap")
        a(class="brand", href="/user")
          span(class="brand-dot")
          | AssistIQ
        a(class="back-link", href="/mechanic-back") Back to Dashboard

    main(class="page")
      div(class="page-header")
        h1 Mechanic Service
        p Select the roadside assistance you need, enter your details, and calculate your estimated bill instantly.

      div(class="form-card")
        form#mechanicForm(method="post", action="#")
          div(class="form-grid")
            div(class="field")
              label(for="name") Full Name
              input#name(type="text", name="name", placeholder="Enter your name", required)

            div(class="field")
              label(for="email") Email
              input#email(type="email", name="email", placeholder="you@example.com", required)

            div(class="field full")
              label(for="phone") Phone
              input#phone(type="tel", name="phone", placeholder="+91 98765 43210", required)

            div(class="services-section")
              h2 Select Services
              div(class="services-grid")
                label(class="service-option")
                  input(type="checkbox", name="services", value="petrol", data-price="110")
                  span Petrol
                  span(class="price") Rs.110
                label(class="service-option")
                  input(type="checkbox", name="services", value="tires", data-price="1500")
                  span Tires
                  span(class="price") Rs.1500
                label(class="service-option")
                  input(type="checkbox", name="services", value="diagnostics", data-price="700")
                  span Diagnostics
                  span(class="price") Rs.700
                label(class="service-option")
                  input(type="checkbox", name="services", value="lockout", data-price="500")
                  span Lockout
                  span(class="price") Rs.500
                label(class="service-option")
                  input(type="checkbox", name="services", value="oil-change", data-price="300")
                  span Oil Change
                  span(class="price") Rs.300

            div(class="bill-row")
              div(class="field")
                label(for="totalBill") Total Bill
                input#totalBill(type="text", name="totalBill", value="Rs. 0", readonly)

            div(class="form-actions")
              button(type="submit", class="btn-submit") Submit Request

    footer(class="footer") AssistIQ

    script(src="/js/mechanic-service.js")
